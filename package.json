{
  "name": "alles-fuer-die-tiere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=dist/worker.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:db": "tsx scripts/integration-claim-draft.ts",
    "test:auth-db": "tsx scripts/integration-password-login.ts",
    "test:action-db": "tsx scripts/integration-current-action.ts",
    "test:project-db": "tsx scripts/integration-project-publication.ts",
    "test:source-db": "tsx scripts/integration-source-observation.ts",
    "test:jobs-db": "tsx scripts/integration-job-queue.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.3",
    "openai": "^7.25.0",
    "postgres": "^3.4.9"
  }
}
