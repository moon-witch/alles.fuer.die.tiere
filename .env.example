# Leave empty during local development to disable the temporary reveal gate.
# Set both values in Coolify before the reveal deployment.
REVEAL_GATE_ENABLED=false
REVEAL_GATE_PASSWORD=
SESSION_SECRET=
DATABASE_URL=postgres://app_write:replace-me@localhost:5432/alles_fuer_die_tiere
PUBLIC_SITE_URL=https://allesfuerdietiere.earth
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Private SeaweedFS S3 endpoint and an existing non-public bucket.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
